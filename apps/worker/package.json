{
  "name": "@relay/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration --testTimeout=30000"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "@relay/db": "workspace:*",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  }
}
