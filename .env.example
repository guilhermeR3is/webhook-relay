DATABASE_URL=postgresql://relay:relay@localhost:5433/relay

# 32 bytes em base64: openssl rand -base64 32
ENCRYPTION_KEY=

API_PORT=3000
# slug do único endpoint que o painel enxerga
DEMO_ENDPOINT_SLUG=demo
# endereços (IP, faixa ou loopback, linklocal, uniquelocal) separados por vírgula cujos cabeçalhos
# X-Forwarded-* a API aceita; vazio = ninguém (acesso direto). Nunca use true: o IP vira forjável.
TRUST_PROXY=
# sal do hash do IP nas cotas do botão de teste (mínimo 16 caracteres): openssl rand -base64 24
DEMO_QUOTA_SALT=
# origem do painel que pode ler a resposta do botão de teste
PANEL_ORIGIN=http://localhost:3100
# endereço da API que o painel (apps/web) consulta; no compose vale o nome do serviço
API_URL=http://localhost:3000
# endereço da API que o NAVEGADOR usa (botão de evento de teste); no compose é o da máquina, não o do serviço
PUBLIC_API_URL=http://localhost:3000
WORKER_PORT=3001
WORKER_POLL_INTERVAL_MS=1000

# libera destinos em rede privada ou localhost; em produção deixe false (proteção contra SSRF)
ALLOW_PRIVATE_DESTINATIONS=true
LOG_LEVEL=info
