{
  "name": "@relay/load",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "tsx --env-file=../.env src/seed.ts",
    "unseed": "tsx --env-file=../.env src/seed.ts unseed",
    "receiver": "node src/receiver-main.ts",
    "chaos": "tsx --env-file=../.env src/chaos.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration --testTimeout=30000"
  },
  "dependencies": {
    "@relay/db": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
