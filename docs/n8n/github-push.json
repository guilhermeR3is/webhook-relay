{
  "id": "relayGithubPush1",
  "name": "Relay: eventos push do GitHub",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-push",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "da4a70b7-ae39-4c5c-9735-2c2421c42305",
      "name": "Webhook do relay",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "3fb4b49c-acf3-4621-9e62-741e40ef5c09"
    },
    {
      "parameters": {
        "jsCode": "const webhookId = $input.first().json.headers['webhook-id'];\nconst processed = $getWorkflowStaticData('global');\nprocessed.ids = processed.ids ?? {};\n\nconst duplicate = Object.hasOwn(processed.ids, webhookId);\nif (!duplicate) {\n  processed.ids[webhookId] = Date.now();\n  // sem teto a lista cresceria para sempre\n  const newest = Object.entries(processed.ids)\n    .sort((a, b) => b[1] - a[1])\n    .slice(0, 500);\n  processed.ids = Object.fromEntries(newest);\n}\n\nreturn [{ json: { webhookId, duplicate, body: $input.first().json.body } }];"
      },
      "id": "b809cadc-382e-4bba-8a41-5e7d6a2000a5",
      "name": "Evitar duplicada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "5082ddd4-e7f0-47ec-8ed2-f94b3a501484",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1213102-fb0f-43d8-9605-5b364c2e12b5",
      "name": "É duplicada?",
