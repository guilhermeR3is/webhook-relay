      "typeVersion": 2.3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { received: true, duplicate: true, webhookId: $json.webhookId } }}",
        "options": {}
      },
