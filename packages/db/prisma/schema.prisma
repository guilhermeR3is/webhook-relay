generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SignatureScheme {
  none
  generic_hmac
  github

  @@map("signature_scheme")
}

model Endpoint {
  id              String          @id @default(uuid(7)) @db.Uuid
  slug            String          @unique
  name            String
  signatureScheme SignatureScheme @map("signature_scheme")
  secretEncrypted String?         @map("secret_encrypted")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  destinations Destination[]
  events       Event[]

  @@map("endpoint")
}

enum CircuitState {
  closed
  open
  half_open

  @@map("circuit_state")
}

model Destination {
  id                  String       @id @default(uuid(7)) @db.Uuid
  endpointId          String       @map("endpoint_id") @db.Uuid
  url                 String
  secretEncrypted     String       @map("secret_encrypted")
  eventTypes          String[]     @map("event_types")
  isActive            Boolean      @default(true) @map("is_active")
  circuitState        CircuitState @default(closed) @map("circuit_state")
  consecutiveFailures Int          @default(0) @map("consecutive_failures")
  circuitOpenedAt     DateTime?    @map("circuit_opened_at") @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  endpoint   Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@map("destination")
}

model Event {
  id             String   @id @default(uuid(7)) @db.Uuid
  endpointId     String   @map("endpoint_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  eventType      String   @map("event_type")
  headers        Json
  body           Bytes
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  endpoint   Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  deliveries Delivery[]

  @@unique([endpointId, idempotencyKey])
  @@index([endpointId, receivedAt(sort: Desc), id(sort: Desc)])
  @@map("event")
}

enum DeliveryStatus {
  pending
  in_progress
  succeeded
  dead

  @@map("delivery_status")
}

model Delivery {
  id            String         @id @default(uuid(7)) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  destinationId String         @map("destination_id") @db.Uuid
  status        DeliveryStatus @default(pending)
  attemptCount  Int            @default(0) @map("attempt_count")
  nextAttemptAt DateTime       @default(dbgenerated("CURRENT_TIMESTAMP")) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?      @map("locked_until") @db.Timestamptz(3)
  lastError     String?        @map("last_error")
  succeededAt   DateTime?      @map("succeeded_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  attempts    Attempt[]
  resends     Resend[]

  @@unique([eventId, destinationId])
  @@index([status, nextAttemptAt])
  @@map("delivery")
}

model Attempt {
  id              String   @id @default(uuid(7)) @db.Uuid
  deliveryId      String   @map("delivery_id") @db.Uuid
  startedAt       DateTime @map("started_at") @db.Timestamptz(3)
  durationMs      Int      @map("duration_ms")
  httpStatus      Int?     @map("http_status")
  responseSnippet String?  @map("response_snippet")
  error           String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, startedAt])
  @@map("attempt")
}

model Resend {
  id             String   @id @default(uuid(7)) @db.Uuid
  deliveryId     String   @map("delivery_id") @db.Uuid
  requestedAt    DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("requested_at") @db.Timestamptz(3)
  attemptsBefore Int      @map("attempts_before")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, requestedAt])
  @@map("resend")
}

enum DemoQuotaKind {
  ip
  global

  @@map("demo_quota_kind")
}

model DemoQuota {
  id          String        @id @default(uuid(7)) @db.Uuid
  kind        DemoQuotaKind
  key         String
  windowStart DateTime      @map("window_start") @db.Timestamptz(3)
  count       Int           @default(0)

  @@unique([kind, key, windowStart])
  @@map("demo_quota")
}
