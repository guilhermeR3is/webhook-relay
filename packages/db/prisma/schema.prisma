generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SignatureScheme {
  none
  generic_hmac
  github

  @@map("signature_scheme")
}

model Endpoint {
  id              String          @id @default(uuid(7)) @db.Uuid
  slug            String          @unique
  name            String
  signatureScheme SignatureScheme @map("signature_scheme")
  secretEncrypted String?         @map("secret_encrypted")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  destinations Destination[]
  events       Event[]

  @@map("endpoint")
}

model Destination {
  id              String   @id @default(uuid(7)) @db.Uuid
  endpointId      String   @map("endpoint_id") @db.Uuid
  url             String
  secretEncrypted String   @map("secret_encrypted")
  eventTypes      String[] @map("event_types")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  endpoint   Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@map("destination")
}

model Event {
  id             String   @id @default(uuid(7)) @db.Uuid
  endpointId     String   @map("endpoint_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  eventType      String   @map("event_type")
  headers        Json
  body           Bytes
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  endpoint   Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  deliveries Delivery[]

  @@unique([endpointId, idempotencyKey])
  @@map("event")
}

enum DeliveryStatus {
  pending
  in_progress
  succeeded
  dead

  @@map("delivery_status")
}

model Delivery {
  id            String         @id @default(uuid(7)) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  destinationId String         @map("destination_id") @db.Uuid
  status        DeliveryStatus @default(pending)
  attemptCount  Int            @default(0) @map("attempt_count")
  nextAttemptAt DateTime       @default(dbgenerated("CURRENT_TIMESTAMP")) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?      @map("locked_until") @db.Timestamptz(3)
  lastError     String?        @map("last_error")
  succeededAt   DateTime?      @map("succeeded_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@unique([eventId, destinationId])
  @@index([status, nextAttemptAt])
  @@map("delivery")
}
